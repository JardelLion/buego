<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View buego.dashboard View List -->
    <record id="view_buego_dashboard_list" model="ir.ui.view">
        <field name="name">view.buego.dashboard.list</field>
        <field name="model">buego.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View buego.dashboard form -->
    <record id="view_buego_dashboard_form" model="ir.ui.view">
        <field name="name">view.buego.dashboard.form</field>
        <field name="model">buego.dashboard</field>
        <field name="arch" type="xml">
            <form string="Buego Dashboard">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View buego.dashboard search -->
    <record id="view_buego_dashboard_search" model="ir.ui.view">
        <field name="name">view.buego.dashboard.search</field>
        <field name="model">buego.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action buego.dashboard -->
    <record id="action_buego_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">buego.dashboard</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Buego Dashboard.
            </p>
        </field>
    </record>

    <menuitem id="buego_dashboard" name="Dashboard" action="action_buego_dashboard" parent="buego_menu" sequence="10"/>

</odoo>
