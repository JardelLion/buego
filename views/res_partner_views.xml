<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="res_model">res.partner</field>
        <field name='domain'>[('is_company', '=', False)]</field>
    </record>

    <!-- Wrap the xpath inside an inherited view record -->
    <record id="view_partner_form_inherit_buego" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.buego</field>
        <field name="model">res.partner</field>
        <!-- Replace base.view_partner_form with the exact XML ID of the view you want to inherit -->
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']"  position="inside">
                <button name="action_destination" icon="fa-location-arrow" string="Destination" type="object" invisible="destination_count == 0">
                     <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="destination_count"/></span>
                        <span class="o_stat_text">Destination</span>
                    </div>
                </button>

            </xpath>
        </field>
    </record>
    <menuitem id="buego_contacts_menu" name="Contacts" action="contacts.action_contacts"
        parent="buego_menu" sequence="10"/>


</odoo>
